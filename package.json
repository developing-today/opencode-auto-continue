{
  "name": "opencode-auto-continue",
  "version": "2.0.0",
  "description": "OpenCode plugin that auto-sends 'continue' when bad request (400) errors occur",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "auto-continue",
    "error-recovery"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.28"
  },
  "devDependencies": {
    "@opencode/client": "2.0.32",
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  }
}
