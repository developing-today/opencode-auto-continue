{
  "name": "opencode-auto-continue",
  "version": "2.0.0",
  "description": "OpenCode plugin that sends 'continue' when a session goes idle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "auto-continue",
    "idle"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.0",
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  }
}
